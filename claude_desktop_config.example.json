{
  "mcpServers": {
    "local-memory": {
      "command": "node",
      "args": [
        "YOUR_USERPROFILE/.claude/mcp/memory-proxy.cjs"
      ],
      "env": {
        "MCP_MEMORY_SERVER_CMD": "npx",
        "MCP_MEMORY_SERVER_ARGS": "-y @modelcontextprotocol/server-memory"
      }
    },
    "mcp_docker": {
      "command": "C:\\Program Files\\Docker\\cli-plugins\\docker-mcp.exe",
      "args": [
        "gateway",
        "run"
      ],
      "env": {
        "ProgramData": "C:\\ProgramData",
        "LOCALAPPDATA": "C:\\Users\\YOUR_USERNAME\\AppData\\Local",
        "APPDATA": "C:\\Users\\YOUR_USERNAME\\AppData\\Roaming",
        "USERPROFILE": "C:\\Users\\YOUR_USERNAME",
        "SystemRoot": "C:\\Windows"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "github": {
      "command": "YOUR_USERPROFILE/AppData/Local/github/github-mcp-server.exe",
      "args": [
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PAT"
      }
    },
    "n8n-local": {
      "command": "node",
      "args": [
        "C:/Users/YOUR_USERNAME/n8n-mcp-fix-proxy.mjs",
        "http://YOUR_N8N_HOST:5678/mcp-server/http",
        "--allow-http",
        "--header",
        "Bearer YOUR_N8N_TOKEN"
      ]
    },
    "curl-client": {
      "command": "npx",
      "args": [
        "-y",
        "@calibress/curl-mcp"
      ]
    },
    "alolite-ssh": {
      "command": "npx",
      "args": [
        "-y",
        "@alolite/ssh-mcp"
      ],
      "env": {
        "SSH_HOST": "YOUR_SSH_HOST",
        "SSH_USER": "YOUR_SSH_USER",
        "SSH_PASSWORD": "YOUR_SSH_PASSWORD",
        "PROGRAMDATA": "C:\\ProgramData"
      }
    },
    "tavily-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@latest"
      ],
      "env": {
        "TAVILY_API_KEY": "YOUR_TAVILY_API_KEY"
      }
    },
    "tavily2-mc": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@latest"
      ],
      "env": {
        "TAVILY_API_KEY": "YOUR_TAVILY_API_KEY"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "orchestrator-mcp": {
      "command": "node",
      "args": [
        "YOUR_USERPROFILE/orchestrator-mcp/index.js"
      ],
      "env": {
        "ROUTERAI_API_KEY": "YOUR_ROUTERAI_API_KEY",
        "ORCH_PRO_MODEL": "deepseek/deepseek-v4.1-flash",
        "ORCH_FLASH_MODEL": "deepseek/deepseek-chat"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "lean-ctx": {
      "command": "lean-ctx"
    }
  },
  "deploymentMode": "3p",
  "coworkUserFilesPath": "C:\\Users\\YOUR_USERNAME\\Claude",
  "preferences": {
    "ccAutoArchiveInactiveDays": 30,
    "ccdScheduledTasksEnabled": true,
    "coworkBrowserToolsEnabled": true,
    "coworkLegacyRootGrantsPruned": true,
    "coworkScheduledTasksEnabled": true,
    "coworkWebSearchEnabled": true,
    "sidebarMode": "epitaxy"
  }
}
